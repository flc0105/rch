{
  "id": "filebrowser",
  "name": "filebrowser",
  "display_name": "File Browser",
  "description": "Remote file manager for browsing and managing a selected directory.",
  "version": "2.63.3",
  "category": "files",
  "tags": [
    "filebrowser",
    "files",
    "web",
    "http"
  ],
  "platform_packages": {
    "darwin-arm64": {
      "platform": "mac",
      "arch": "arm64",
      "filename": "filebrowser-v2.63.3-darwin-arm64.zip",
      "download_url": "/api/external-tools/packages/filebrowser-v2.63.3-darwin-arm64.zip",
      "root": "",
      "notes": "Archive has no top-level directory; filebrowser executable is at the archive root."
    },
    "linux-amd64": {
      "platform": "linux",
      "arch": "amd64",
      "filename": "filebrowser-v2.63.3-linux-amd64.zip",
      "download_url": "/api/external-tools/packages/filebrowser-v2.63.3-linux-amd64.zip",
      "root": "",
      "notes": "Archive has no top-level directory; filebrowser executable is at the archive root."
    },
    "win-amd64": {
      "platform": "win",
      "arch": "amd64",
      "filename": "filebrowser-v2.63.3-windows-amd64.zip",
      "download_url": "/api/external-tools/packages/filebrowser-v2.63.3-windows-amd64.zip",
      "root": "",
      "notes": "Archive has no top-level directory; filebrowser.exe is at the archive root."
    }
  },
  "binaries": {
    "filebrowser": {
      "paths": {
        "darwin-arm64": "filebrowser",
        "linux-amd64": "filebrowser",
        "win-amd64": "filebrowser.exe"
      }
    }
  },
  "install": {
    "install_dir": "{{external_tools_root}}/{{package_id}}/{{version}}/{{package_key}}"
  },
  "modules": [
    {
      "id": "main",
      "name": "filebrowser",
      "display_name": "File Browser",
      "description": "Serves a selected directory through a browser-based file manager.",
      "execution": "daemon",
      "binary": "filebrowser",
      "params": [
        {
          "name": "instance_name",
          "label": "Instance Name",
          "type": "string",
          "required": true,
          "default": "filebrowser-8080",
          "description": "Unique name for this File Browser instance. It controls database/log/pid isolation."
        },
        {
          "name": "address",
          "label": "Listen Address",
          "type": "string",
          "required": true,
          "default": "127.0.0.1",
          "description": "Address to listen on. Use 0.0.0.0 only when you intentionally expose it on the network."
        },
        {
          "name": "port",
          "label": "Listen Port",
          "type": "integer",
          "required": true,
          "default": 8080,
          "min": 1,
          "max": 65535,
          "description": "HTTP port for File Browser."
        },
        {
          "name": "root",
          "label": "Root Directory",
          "type": "string",
          "required": true,
          "default": "~",
          "description": "Filesystem root served by File Browser."
        },
        {
          "name": "extra_args",
          "label": "Extra Args",
          "type": "string",
          "required": false,
          "default": "",
          "description": "Additional command-line args appended to filebrowser argv. Example: --disable-exec=false"
        }
      ],
      "config": {},
      "runtime": {
        "cwd": "{{install_dir}}",
        "argv": [
          "{{bin_filebrowser}}",
          "-a",
          "{{address}}",
          "-p",
          "{{port}}",
          "-r",
          "{{root}}",
          "-d",
          "{{instance_runtime_dir}}/filebrowser.db"
        ],
        "stdout": "{{instance_runtime_dir}}/stdout.log",
        "stderr": "stdout",
        "pid_file": "{{instance_runtime_dir}}/tool.pid",
        "state_file": "{{instance_runtime_dir}}/state.json",
        "extra_args_param": "extra_args"
      },
      "lifecycle": {
        "stop": {
          "type": "signal",
          "signal": "TERM",
          "timeout_sec": 5,
          "kill_after_timeout": true
        },
        "status": {
          "type": "pid_file"
        }
      }
    }
  ]
}
