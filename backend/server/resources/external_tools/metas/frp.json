{
  "id": "frp",
  "name": "frp",
  "display_name": "FRP",
  "description": "Reverse proxy toolkit for exposing private network services through a relay.",
  "version": "0.68.1",
  "category": "network",
  "tags": [
    "frp",
    "frps",
    "frpc",
    "proxy",
    "tunnel"
  ],
  "source": "https://github.com/fatedier/frp",
  "platform_packages": {
    "darwin-arm64": {
      "platform": "mac",
      "arch": "arm64",
      "filename": "frp-v0.68.1-darwin-arm64.zip",
      "download_url": "/api/external-tools/packages/frp-v0.68.1-darwin-arm64.zip",
      "root": ""
    },
    "linux-amd64": {
      "platform": "linux",
      "arch": "amd64",
      "filename": "frp-v0.68.1-linux-amd64.zip",
      "download_url": "/api/external-tools/packages/frp-v0.68.1-linux-amd64.zip",
      "root": ""
    },
    "win-amd64": {
      "platform": "win",
      "arch": "amd64",
      "filename": "frp-v0.68.1-windows-amd64.zip",
      "download_url": "/api/external-tools/packages/frp-v0.68.1-windows-amd64.zip",
      "root": ""
    }
  },
  "binaries": {
    "frps": {
      "paths": {
        "darwin-arm64": "frps",
        "linux-amd64": "frps",
        "win-amd64": "frps.exe"
      }
    },
    "frpc": {
      "paths": {
        "darwin-arm64": "frpc",
        "linux-amd64": "frpc",
        "win-amd64": "frpc.exe"
      }
    }
  },
  "install": {
    "install_dir": "{{external_tools_root}}/{{package_id}}/{{version}}/{{package_key}}"
  },
  "modules": [
    {
      "id": "frps",
      "name": "frps",
      "display_name": "FRP Server",
      "description": "Runs the relay that accepts FRP client connections.",
      "execution": "daemon",
      "binary": "frps",
      "params": [
        {
          "name": "instance_name",
          "label": "Instance Name",
          "type": "string",
          "required": true,
          "default": "frps-7001",
          "description": "Unique name for this frps instance. It controls config/log/pid isolation."
        },
        {
          "name": "bind_port",
          "label": "FRPS Control Port",
          "type": "integer",
          "required": true,
          "default": 7001,
          "min": 1,
          "max": 65535,
          "description": "frps bind port. frpc connects to this port as server_port."
        }
      ],
      "config": {
        "target": "{{instance_runtime_dir}}/frps.toml",
        "template": "bindPort = {{bind_port}}\n"
      },
      "runtime": {
        "cwd": "{{install_dir}}/{{package_root}}",
        "argv": [
          "{{bin_frps}}",
          "-c",
          "{{instance_runtime_dir}}/frps.toml"
        ],
        "stdout": "{{instance_runtime_dir}}/stdout.log",
        "stderr": "stdout",
        "pid_file": "{{instance_runtime_dir}}/tool.pid",
        "state_file": "{{instance_runtime_dir}}/state.json"
      },
      "lifecycle": {
        "stop": {
          "type": "signal",
          "signal": "TERM",
          "timeout_sec": 5,
          "kill_after_timeout": true
        },
        "status": {
          "type": "pid_file"
        }
      }
    },
    {
      "id": "frpc",
      "name": "frpc",
      "display_name": "FRP Client",
      "description": "Connects local services to an FRP relay.",
      "execution": "daemon",
      "binary": "frpc",
      "params": [
        {
          "name": "instance_name",
          "label": "Instance Name",
          "type": "string",
          "required": true,
          "default": "vite-15173",
          "description": "Unique name for this frpc instance. It controls config/log/pid isolation."
        },
        {
          "name": "server_addr",
          "label": "FRPS Server Address",
          "type": "string",
          "required": true,
          "default": "127.0.0.1",
          "description": "frps server IP or domain."
        },
        {
          "name": "server_port",
          "label": "FRPS Control Port",
          "type": "integer",
          "required": true,
          "default": 7001,
          "min": 1,
          "max": 65535,
          "description": "frps bind port."
        },
        {
          "name": "proxy_name",
          "label": "Proxy Name",
          "type": "string",
          "required": true,
          "default": "vite",
          "description": "Unique proxy name in frpc config."
        },
        {
          "name": "proxy_type",
          "label": "Proxy Type",
          "type": "string",
          "required": true,
          "default": "tcp",
          "description": "FRP proxy type. For local port forwarding, usually use tcp."
        },
        {
          "name": "local_ip",
          "label": "Local IP",
          "type": "string",
          "required": true,
          "default": "127.0.0.1",
          "description": "Local service IP to expose."
        },
        {
          "name": "local_port",
          "label": "Local Port",
          "type": "integer",
          "required": true,
          "default": 5173,
          "min": 1,
          "max": 65535,
          "description": "Local service port to expose."
        },
        {
          "name": "remote_port",
          "label": "Remote Port",
          "type": "integer",
          "required": true,
          "default": 15173,
          "min": 1,
          "max": 65535,
          "description": "Remote port opened by frps."
        }
      ],
      "config": {
        "target": "{{instance_runtime_dir}}/frpc.toml",
        "template": "serverAddr = \"{{server_addr}}\"\nserverPort = {{server_port}}\n\n[[proxies]]\nname = \"{{proxy_name}}\"\ntype = \"{{proxy_type}}\"\nlocalIP = \"{{local_ip}}\"\nlocalPort = {{local_port}}\nremotePort = {{remote_port}}\n"
      },
      "runtime": {
        "cwd": "{{install_dir}}/{{package_root}}",
        "argv": [
          "{{bin_frpc}}",
          "-c",
          "{{instance_runtime_dir}}/frpc.toml"
        ],
        "stdout": "{{instance_runtime_dir}}/stdout.log",
        "stderr": "stdout",
        "pid_file": "{{instance_runtime_dir}}/tool.pid",
        "state_file": "{{instance_runtime_dir}}/state.json"
      },
      "lifecycle": {
        "stop": {
          "type": "signal",
          "signal": "TERM",
          "timeout_sec": 5,
          "kill_after_timeout": true
        },
        "status": {
          "type": "pid_file"
        }
      }
    },
    {
      "id": "frpc_socks5",
      "name": "frpc_socks5",
      "display_name": "FRP Client SOCKS5",
      "description": "Runs FRP's built-in SOCKS5 client plugin and exposes the SOCKS5 entrypoint on the FRPS remote port.",
      "execution": "daemon",
      "binary": "frpc",
      "params": [
        {
          "name": "instance_name",
          "label": "Instance Name",
          "type": "string",
          "required": true,
          "default": "socks5-11080",
          "description": "Unique name for this frpc socks5 instance. It controls config/log/pid isolation."
        },
        {
          "name": "server_addr",
          "label": "FRPS Server Address",
          "type": "string",
          "required": true,
          "default": "127.0.0.1",
          "description": "frps server IP or domain."
        },
        {
          "name": "server_port",
          "label": "FRPS Control Port",
          "type": "integer",
          "required": true,
          "default": 7001,
          "min": 1,
          "max": 65535,
          "description": "frps bind port."
        },
        {
          "name": "proxy_name",
          "label": "Proxy Name",
          "type": "string",
          "required": true,
          "default": "socks5",
          "description": "Unique proxy name in frpc config."
        },
        {
          "name": "remote_port",
          "label": "Remote SOCKS5 Port",
          "type": "integer",
          "required": true,
          "default": 11080,
          "min": 1,
          "max": 65535,
          "description": "Remote SOCKS5 port opened by frps. Clients connect to frps:remote_port."
        }
      ],
      "config": {
        "target": "{{instance_runtime_dir}}/frpc_socks5.toml",
        "template": "serverAddr = \"{{server_addr}}\"\nserverPort = {{server_port}}\n\n[[proxies]]\nname = \"{{proxy_name}}\"\ntype = \"tcp\"\nremotePort = {{remote_port}}\n\n[proxies.plugin]\ntype = \"socks5\"\n"
      },
      "runtime": {
        "cwd": "{{install_dir}}/{{package_root}}",
        "argv": [
          "{{bin_frpc}}",
          "-c",
          "{{instance_runtime_dir}}/frpc_socks5.toml"
        ],
        "stdout": "{{instance_runtime_dir}}/stdout.log",
        "stderr": "stdout",
        "pid_file": "{{instance_runtime_dir}}/tool.pid",
        "state_file": "{{instance_runtime_dir}}/state.json"
      },
      "lifecycle": {
        "stop": {
          "type": "signal",
          "signal": "TERM",
          "timeout_sec": 5,
          "kill_after_timeout": true
        },
        "status": {
          "type": "pid_file"
        }
      }
    }
  ]
}
