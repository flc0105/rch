{
  "id": "keychain-picker-demo",
  "name": "keychain-picker-demo",
  "display_name": "Keychain Picker Demo",
  "description": "One-shot Python bundle demonstrating Secret-to-token parameter binding.",
  "version": "1.0.0",
  "category": "demo",
  "tags": ["python", "bundle", "keychain", "demo"],
  "platform_packages": {
    "common-all": {
      "platform": "*",
      "arch": "all",
      "filename": "keychain-picker-demo-v1.0.0-common-all.zip",
      "download_url": "/api/external-tools/packages/keychain-picker-demo-v1.0.0-common-all.zip",
      "root": ""
    }
  },
  "execs": {
    "python": {
      "paths": {
        "common-all": "app.py"
      },
      "description": "Run the bundled Python demo with the Client runtime.",
      "launcher": {
        "type": "client_python",
        "prefix_args": ["-u"]
      }
    }
  },
  "install": {
    "install_dir": "{{external_tools_root}}/{{package_id}}/{{version}}/{{package_key}}"
  },
  "modules": [
    {
      "id": "token-check",
      "name": "keychain-picker-token-check",
      "display_name": "Keychain Token Picker Demo",
      "description": "Runs once and reports whether the selected token reached the Python bundle.",
      "execution": "oneshot",
      "exec": "python",
      "params": [
        {
          "name": "api_token",
          "label": "API Token",
          "type": "password",
          "required": true,
          "description": "Select a Secret with the key icon, or enter a token manually.",
          "keychain_picker": {
            "kind": "secret",
            "bindings": {"secret_value": "api_token"}
          }
        }
      ],
      "runtime": {
        "cwd": "{{install_dir}}/{{package_root}}",
        "argv": ["{{bin_python}}", "{{api_token}}"],
        "timeout_sec": 30
      }
    }
  ]
}
