{
  "id": "python-heartbeat-log",
  "name": "python-heartbeat-log",
  "display_name": "Python Heartbeat Log (Streaming Test)",
  "description": "Daemon that emits timestamped heartbeat lines to stdout for testing streaming instance logs.",
  "version": "1.0.0",
  "category": "demo",
  "tags": [
    "python",
    "heartbeat",
    "logging",
    "demo"
  ],
  "platform_packages": {
    "common-all": {
      "platform": "*",
      "arch": "all",
      "filename": "python-heartbeat-log-v1.0.0-common-all.zip",
      "download_url": "/api/external-tools/packages/python-heartbeat-log-v1.0.0-common-all.zip",
      "root": ""
    }
  },
  "execs": {
    "heartbeat": {
      "paths": {
        "common-all": "heartbeat.py"
      },
      "description": "Run heartbeat logger",
      "launcher": {
        "type": "client_python",
        "prefix_args": [
          "-u"
        ]
      }
    }
  },
  "install": {
    "install_dir": "{{external_tools_root}}/{{package_id}}/{{version}}/{{package_key}}"
  },
  "modules": [
    {
      "id": "heartbeat",
      "name": "python-heartbeat-log",
      "display_name": "Python Heartbeat Log",
      "description": "Print an incrementing heartbeat to the instance stdout log.",
      "execution": "daemon",
      "exec": "heartbeat",
      "params": [
        {
          "name": "interval",
          "label": "Interval (seconds)",
          "type": "number",
          "required": false,
          "default": 2,
          "min": 0.2,
          "max": 3600,
          "description": "Seconds between heartbeat lines"
        }
      ],
      "runtime": {
        "cwd": "{{install_dir}}/{{package_root}}",
        "argv": [
          "{{bin_heartbeat}}",
          "--interval",
          "{{interval}}"
        ],
        "stdout": "{{instance_runtime_dir}}/stdout.log",
        "stderr": "stdout",
        "pid_file": "{{instance_runtime_dir}}/tool.pid",
        "state_file": "{{instance_runtime_dir}}/state.json"
      },
      "lifecycle": {
        "stop": {
          "type": "signal",
          "signal": "TERM",
          "timeout_sec": 5,
          "kill_after_timeout": true
        },
        "status": {
          "type": "pid_file"
        }
      }
    }
  ]
}
