{
  "common": {
    "pysleep": "pyexec_stream import time; time.sleep(<sec>)",
    "open_url": "pyexec_collect import webbrowser;webbrowser.open('<url>')",
    "now": "pyexec_collect import datetime;print(datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))",
    "python_version": "pyexec_collect import sys;print(sys.version)",
    "rch_whoami": "pyexec_collect import getpass;print(getpass.getuser())",
    "rch_hostname": "pyexec_collect import socket;print(socket.gethostname())",
    "rch_uuid": "pyexec_collect import uuid;print(uuid.uuid4())",
    "cwd": "pyexec_collect import os;print(os.getcwd())",
    "rch_paste": "pyexec_collect import pyperclip; print(pyperclip.paste())",
    "rch_copy": "pyexec_collect import pyperclip;pyperclip.copy(\"<text>\")",

    "test_noargs": "pyexec_collect print('no-args-ok')",
    "test_one": "pyexec_collect print('value=<value>')",
    "test_repeat3": "pyexec_collect print('<word>|<word>|<word>')",
    "test_pair_repeat": "pyexec_collect print('left=<left> | right=<right> | left_again=<left> | right_again=<right>')",
    "test_first_seen_order": "pyexec_collect print('second=<second> | first=<first> | second_again=<second> | first_again=<first>')",
    "test_mix3": "pyexec_collect print('a=<a> | b=<b> | a2=<a> | c=<c> | b2=<b> | a3=<a>')",
    "test_space": "pyexec_collect print('text=[<text>]')"
  },
  "win": {
    "list_av": "powershell Get-CimInstance -Namespace root/SecurityCenter2 -ClassName AntivirusProduct ^| Select-Object displayName",
    "list_startup": "powershell Get-CimInstance Win32_StartupCommand ^| Select-Object Name, Command, Location",
    "list_ports": "powershell Get-NetTCPConnection -State Listen ^| Sort-Object LocalPort ^| Select-Object LocalAddress, LocalPort, OwningProcess",
    "list_services": "powershell Get-Service ^| Sort-Object Status,DisplayName ^| Select-Object Status,Name,DisplayName",
    "list_env": "powershell Get-ChildItem Env: ^| Sort-Object Name",
    "list_users": "powershell Get-LocalUser ^| Select-Object Name, Enabled, LastLogon",
    "download_file": "powershell Invoke-WebRequest -Uri <url> -OutFile <file>",
    "run_as_admin": "powershell Start-Process -Verb runas <command>",
    "show_desktop": "powershell (New-Object -ComObject shell.application).toggleDesktop()",
    "kill_port": "powershell Stop-Process -Id (Get-NetTCPConnection -LocalPort <port>).OwningProcess",
    "ls": "powershell Get-ChildItem",
    "ll": "powershell Get-ChildItem -Force",
    "pwd": "powershell Get-Location",
    "cat": "powershell Get-Content <file>",
    "wc": "powershell Get-Content <file> ^| Measure-Object -Line -Word -Character",
    "zip": "powershell Compress-Archive -Path <src> -DestinationPath <zipfile>",
    "unzip": "powershell Expand-Archive -Path <zipfile> -DestinationPath <dir>",
    "touch": "type nul > <filename>",
    "lock_screen": "rundll32 user32.dll,LockWorkStation",
    "ps": "tasklist",
    "kill_pid": "taskkill /pid <pid> /f",
    "kill_name": "taskkill /im <name> /f",
    "md5": "certUtil -hashfile <file> MD5",
    "is_admin_ps": "powershell.exe ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
    "list_ips": "powershell Get-NetIPAddress -AddressFamily IPv4 ^| Select-Object InterfaceAlias, IPAddress",
    "show_os_info": "powershell Get-ComputerInfo ^| Select-Object WindowsProductName, WindowsVersion, OsHardwareAbstractionLayer",
    "show_hardware_info": "wmic computersystem get manufacturer,model",
    "is_admin": "fltmc >nul 2>&1 && echo Administrator || echo Not Administrator",
    "show_uptime": "powershell (Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime",
    "show_disk_usage": "powershell Get-CimInstance Win32_LogicalDisk -Filter \\\"DriveType=3\\\" ^| Select-Object DeviceID,VolumeName,@{Name='Size';Expression={('{0:N2} GB' -f ($_.Size/1GB))}},@{Name='FreeSpace';Expression={('{0:N2} GB' -f ($_.FreeSpace/1GB))}}",
    "port_info": "powershell Get-NetTCPConnection -LocalPort <port> ^| Select-Object LocalAddress,LocalPort,RemoteAddress,RemotePort,State,OwningProcess",
    "show_firewall": "powershell Get-NetFirewallProfile ^| Select-Object Name,Enabled,DefaultInboundAction,DefaultOutboundAction",
    "show_battery": "powershell Get-CimInstance Win32_Battery ^| Select-Object Name,BatteryStatus,EstimatedChargeRemaining",
    "top_memory": "powershell Get-Process ^| Sort-Object WorkingSet64 -Descending ^| Select-Object -First 15 Id,ProcessName,@{N='Memory';E={if($_.WorkingSet64 -ge 1GB){'{0:N2} GB' -f ($_.WorkingSet64/1GB)}else{'{0:N2} MB' -f ($_.WorkingSet64/1MB)}}}",
    "top_cpu": "powershell Get-Process ^| Sort-Object CPU -Descending ^| Select-Object -First 15 Id,ProcessName,@{N='CPUTime';E={$t=[TimeSpan]::FromSeconds($_.CPU); '{0}:{1:D2}:{2:D2}' -f [int]$t.TotalHours,$t.Minutes,$t.Seconds}}"
  },
  "mac": {
    "ll": "ls -la",
    "sleep": "read ping -c <sec> 127.0.0.1",
    "kill_port": "kill -9 $(lsof -t -i:<port>)",
    "public_ip": "curl -s ifconfig.me;echo",
    "clean_apple_junk": "find . -name \"._*\" -type f -delete && find . -name \".DS_Store\" -type f -delete",
    "local_ip": "ipconfig getifaddr en0",
    "wifi_password": "security find-generic-password -wa <ssid>",
    "list_xattrs": "xattr -l <path>",
    "port_info": "lsof -nP -iTCP:\"<port>\" -sTCP:LISTEN",
    "keep_awake_self": "nohup caffeinate -i -w ${rch:pid} >/dev/null 2>&1 &",
    "keep_awake_status": "pgrep -af caffeinate",
    "disable_gatekeeper": "sudo spctl --master-disable",
    "enable_gatekeeper": "sudo spctl --master-enable",
    "remove_quarantine": "xattr -d com.apple.quarantine <path>",
    "pause_pid": "kill -STOP <pid>",
    "resume_pid": "kill -CONT <pid>",
    "list_path": "echo $PATH | tr ':' '\\n'",
    "show_power_assertions": "pmset -g assertions",
    "notifier": "nohup /Library/Frameworks/Python.framework/Versions/3.10/bin/python3 /Users/flc/PycharmProjects/rch/desktop_notifier/run.py --tray --config /Users/flc/PycharmProjects/rch/desktop_notifier/config.json &",
    "rg": "grep -RInHi -I \"<keyword>\" .",


        "host_probe": "read sh -c 'echo \"=== <host> ===\"; echo \"Ping count: <count>\"; ping -c <count> \"<host>\"; echo \"--- DNS ---\"; dscacheutil -q host -a name \"<host>\"'",

    "path_info": "read sh -c 'echo \"=== <path> ===\"; ls -ld \"<path>\"; echo \"--- file ---\"; file \"<path>\"; echo \"--- stat ---\"; stat -f \"size=%z bytes | mode=%Sp | modified=%Sm\" -t \"%Y-%m-%d %H:%M:%S\" \"<path>\"'",

    "port_probe": "read sh -c 'echo \"=== TCP <port> ===\"; echo \"--- listeners ---\"; lsof -nP -iTCP:<port> -sTCP:LISTEN || true; echo \"--- all connections ---\"; lsof -nP -iTCP:<port> || true'",

    "http_probe": "read sh -c 'echo \"=== <url> ===\"; curl -L -sS -o /dev/null -w \"HTTP: %{http_code}\\nRemote: %{remote_ip}\\nDNS: %{time_namelookup}s\\nConnect: %{time_connect}s\\nTTFB: %{time_starttransfer}s\\nTotal: %{time_total}s\\n\" \"<url>\"'",

    "git_summary": "read sh -c 'cd \"<path>\" && echo \"=== <path> ===\" && git status --short --branch && echo \"--- latest commit ---\" && git log -1 --oneline'",

    "find_in": "read grep -RInHi -I \"<keyword>\" \"<path>\"",

    "sha256": "read shasum -a 256 \"<file>\"",

    "disk_for": "read df -h \"<path>\""
  },
  "linux": {},
  "ios": {}
}